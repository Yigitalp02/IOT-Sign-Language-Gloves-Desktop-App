{
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devPath": "http://localhost:1420",
    "distDir": "../dist",
    "withGlobalTauri": false
  },
  "package": {
    "productName": "IoT Sign Language",
    "version": "1.0.4"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "shell": {
        "all": false,
        "open": true
      }
    },
    "updater": {
      "active": true,
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNBMTNFNzU4MTE3QkU5MkEKUldRcTZYc1JXT2NUT2o2Y05GUjhVMEFtSWs5cWl2S3hEK0VHOHdTQjhsK3Q0a0xuSGgzTWZwLysK",
      "endpoints": [
        "https://github.com/Yigitalp02/IOT-Sign-Language-Gloves-Desktop-App/releases/latest/download/latest.json"
      ]
    },
    "bundle": {
      "active": true,
      "targets": ["nsis", "msi"],
      "identifier": "com.iot.signlanguage",
      "resources": [
        "../webgl-build/**/*",
        "resources/model-server/**/*"
      ],
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ]
    },
    "security": {
      "csp": null
    },
    "windows": [
      {
        "fullscreen": false,
        "resizable": true,
        "title": "IoT Sign Language - ASL Recognition",
        "width": 1200,
        "height": 900,
        "minWidth": 800,
        "minHeight": 600,
        "additionalBrowserArgs": "--disable-application-cache --disable-offline-load-stale-cache"
      }
    ]
  }
}

